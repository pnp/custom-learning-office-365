{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./lib",
    "rootDirs": [
      "./src",
      "./temp/loc-ts",
      "./temp/sass-ts",
      "./temp/static-asset-ts"
    ],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
